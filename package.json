{
  "name": "crafted-ui",
  "private": false,
  "version": "0.3.0",
  "description": "Crafted UI is a React component library styled with Tailwind",
  "type": "module",
  "author": "https://github.com/nmiller44",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmiller44/crafted-ui.git"
  },
  "homepage": "https://crafted-ui.com",
  "bugs": {
    "url": "https://github.com/nmiller44/crafted-ui/issues"
  },
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./styles": "./dist/library.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "clsx": "^2.1.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "10.5.5",
    "globals": "^15.15.0",
    "storybook": "10.5.5",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^4.5.3",
    "@storybook/addon-docs": "10.5.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
